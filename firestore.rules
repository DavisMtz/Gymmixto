rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Caché de lectura: cualquier usuario autenticado (sesión anónima) puede leer.
    // Las escrituras solo ocurren vía Cloud Functions (Admin SDK, que ignora estas reglas).
    match /usuarios/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /registros/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /pagos/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /meta/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Los PIN nunca son accesibles desde el cliente (solo Functions).
    match /pins/{doc} {
      allow read, write: if false;
    }

    // Todo lo demás, denegado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
