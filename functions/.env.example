# Variables de entorno de las Cloud Functions.
# Copia a functions/.env y rellena (no se commitea).

# ID de la Hoja de Google (de la URL: docs.google.com/spreadsheets/d/<ESTE_ID>/edit)
SPREADSHEET_ID=

# Región de las Functions (debe coincidir con NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION del web).
FUNCTIONS_REGION=us-central1

# OPCIONAL: JSON del service account con acceso a la Hoja (en una sola línea).
# Si se omite, se usan las credenciales por defecto de las Functions
# (entonces comparte la Hoja con el email de esa cuenta de servicio como Editor).
# SHEETS_SA_JSON={"type":"service_account",...}
